{
  "name": "switchboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:lib": "npm run check:export && npm run check:rawjson",
    "check:export": "esbuild src/lib/export-markdown.check.ts --bundle --format=esm | node --input-type=module",
    "check:rawjson": "esbuild src/lib/raw-json.check.ts --bundle --format=esm | node --input-type=module",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^15.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vite": "^6.3.2"
  }
}
