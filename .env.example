# Switchboard model-provider config — copy to `.env` (gitignored) and fill in.
# Read once at server start; injected into `claude` spawn for external providers.
# Claude is the default provider and needs NO config here (zero-config).
#
# DeepSeek (Anthropic-compatible endpoint). All four required to enable DeepSeek.
ORCH_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
ORCH_DEEPSEEK_AUTH_TOKEN=sk-your-deepseek-key-here
ORCH_DEEPSEEK_MODEL=deepseek-v4-pro
ORCH_DEEPSEEK_SMALL_FAST_MODEL=deepseek-v4-flash

# Ollama via Claude CLI + Ollama Anthropic compatibility.
# Required to enable Ollama:
ORCH_OLLAMA_BASE_URL=https://ollama.com
ORCH_OLLAMA_MODEL=gemma4:31b-cloud
# Optional:
# ORCH_OLLAMA_AUTH_TOKEN=local-token
# ORCH_OLLAMA_SMALL_FAST_MODEL=gemma4:31b-cloud
# ORCH_OLLAMA_EFFORT=low
